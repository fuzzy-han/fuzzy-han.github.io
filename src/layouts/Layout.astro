---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import SystemStatus from '../components/SystemStatus.astro';

interface Props {
  title: string;
  showSidebar?: boolean;
  activePage?: string;
}

const { title, showSidebar = true, activePage = '' } = Astro.props;
const manualTitle = "AutoOJ使用手册";

const navLinks = [
  { name: "系统介绍", id: "intro", url: "/intro" },
  { name: "日程安排", id: "schedule", url: "/schedule" },
  { name: "评分标准", id: "grading", url: "/grading" },
  { name: "常见问题", id: "faq", url: "/faq" },
  { name: "特别鸣谢", id: "logs", url: "/logs" },
  { name: "⚡ Gemini 3.7 Flash", id: "gemini", url: "/gemini3.7flash/" },
  { name: "🎮 游戏大厅", id: "game", url: "/game/" },
];
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <title>{title} - {manualTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
    <ClientRouter />
    
    <script is:inline>
      // Theme Logic - Immediate Execution
      const THEME_KEY = 'auto-oj-theme';
      
      function getTheme() { 
        return localStorage.getItem(THEME_KEY) || 'dark'; 
      }
      
      function saveTheme(theme) { 
        localStorage.setItem(THEME_KEY, theme); 
      }

      function applyThemeRoot(theme) {
        if (theme === 'dark') {
          document.documentElement.setAttribute('data-theme', 'dark');
        } else {
          document.documentElement.removeAttribute('data-theme');
        }
      }
      
      // Execute immediately to prevent flash
      applyThemeRoot(getTheme());

      // Sidebar & Mobile Logic
      const SIDEBAR_KEY = 'auto-oj-sidebar-closed';
      const MOBILE_SIDEBAR_KEY = 'auto-oj-mobile-sidebar-open';
      
      function isMobile() { 
        return window.innerWidth <= 768; 
      }
      
      function getSidebarState() { 
        return localStorage.getItem(SIDEBAR_KEY) === 'true'; 
      }
      
      function saveSidebarState(closed) { 
        localStorage.setItem(SIDEBAR_KEY, closed); 
      }
      
      function getMobileSidebarState() { 
        return localStorage.getItem(MOBILE_SIDEBAR_KEY) === 'true'; 
      }
      
      function saveMobileSidebarState(open) { 
        localStorage.setItem(MOBILE_SIDEBAR_KEY, open); 
      }

      // UI Update Logic (Deferred)
      function updateThemeIcon(theme) {
        const themeIcon = document.getElementById('themeIcon');
        if (!themeIcon) return;
        
        if (theme === 'dark') {
          themeIcon.innerHTML = '<circle cx="12" cy="12" r="5"/><path d="M12 1v2m0 18v2M4.22 4.22l1.42 1.42m12.72 12.72l1.42 1.42M1 12h2m18 0h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>';
        } else {
          themeIcon.innerHTML = '<path d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.389 5.389 0 0 1-4.4 2.26 5.403 5.403 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1z"/>';
        }
      }

      function initSidebar() {
        const sidebar = document.getElementById('sidebar');
        const shell = document.querySelector('.cyber-shell');
        const overlay = document.getElementById('sidebarOverlay');
        
        if (!sidebar) return;

        if (isMobile()) {
          sidebar.classList.remove('mobile-open');
          if (overlay) overlay.classList.remove('active');
        } else {
          const closed = getSidebarState();
          if (closed && shell) {
            sidebar.classList.add('collapsed');
            shell.classList.add('sidebar-collapsed');
          } else {
            sidebar.classList.remove('collapsed');
            if (shell) shell.classList.remove('sidebar-collapsed');
          }
        }
      }

      // Global Handlers
      window.toggleTheme = function() {
        const current = getTheme();
        const next = current === 'light' ? 'dark' : 'light';
        saveTheme(next);
        applyThemeRoot(next);
        updateThemeIcon(next);
      };

      window.toggleSidebar = function() {
        const sidebar = document.getElementById('sidebar');
        const shell = document.querySelector('.cyber-shell');
        const overlay = document.getElementById('sidebarOverlay');
        
        if (!sidebar) return;

        if (isMobile()) {
          const isOpen = sidebar.classList.contains('mobile-open');
          const next = !isOpen;
          saveMobileSidebarState(next);
          
          if (next) {
            sidebar.classList.add('mobile-open');
            if (overlay) overlay.classList.add('active');
          } else {
            sidebar.classList.remove('mobile-open');
            if (overlay) overlay.classList.remove('active');
          }
        } else {
          const isClosed = sidebar.classList.contains('collapsed');
          const next = !isClosed;
          saveSidebarState(next);
          
          if (next) {
            sidebar.classList.add('collapsed');
            if (shell) shell.classList.add('sidebar-collapsed');
          } else {
            sidebar.classList.remove('collapsed');
            if (shell) shell.classList.remove('sidebar-collapsed');
          }
        }
      };

      window.closeSidebar = function() {
        if (isMobile()) {
          const sidebar = document.getElementById('sidebar');
          const overlay = document.getElementById('sidebarOverlay');
          if (sidebar) sidebar.classList.remove('mobile-open');
          if (overlay) overlay.classList.remove('active');
        }
      };
      
      // Busuanzi Integration
      function loadBusuanzi() {
        const scriptId = 'busuanzi-script';
        if (document.getElementById(scriptId)) return; // Prevent duplicate
        
        const script = document.createElement('script');
        script.id = scriptId;
        script.src = '//busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js';
        script.async = true;
        document.body.appendChild(script);
      }

      // Lifecycle Handlers
      function onPageLoad() {
        updateThemeIcon(getTheme());
        initSidebar();
        loadBusuanzi();
        
        // Resize listener (ensure single registration)
        window.removeEventListener('resize', handleResize);
        window.addEventListener('resize', handleResize);
      }
      
      function handleResize() {
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('sidebarOverlay');
        const shell = document.querySelector('.cyber-shell');
        
        if (!sidebar) return;

        if (isMobile()) {
          sidebar.classList.remove('collapsed');
          if (shell) shell.classList.remove('sidebar-collapsed');
          sidebar.classList.remove('mobile-open');
          if (overlay) overlay.classList.remove('active');
        } else {
          sidebar.classList.remove('mobile-open');
          if (overlay) overlay.classList.remove('active');
          
          // Re-apply desktop state
          const closed = getSidebarState();
          if (closed && shell) {
            sidebar.classList.add('collapsed');
            shell.classList.add('sidebar-collapsed');
          } else {
            sidebar.classList.remove('collapsed');
            if (shell) shell.classList.remove('sidebar-collapsed');
          }
        }
      }

      // Init
      document.addEventListener('DOMContentLoaded', onPageLoad);
      document.addEventListener('astro:after-swap', () => {
        applyThemeRoot(getTheme());
        onPageLoad();
      });
    </script>

    <style is:inline>
      /* image lightbox */
      .image-lightbox { position: fixed; inset: 0; display: flex; align-items: center; justify-content: center; visibility: hidden; opacity: 0; transition: opacity .18s ease; pointer-events: none; z-index: 2200; }
      .image-lightbox.active { visibility: visible; opacity: 1; pointer-events: auto; }
      .image-lightbox-overlay { position: absolute; inset: 0; background: rgba(0,0,0,0.85); backdrop-filter: blur(6px); }
      .image-lightbox img { max-width: 95vw; max-height: 95vh; border-radius: 8px; box-shadow: 0 18px 50px rgba(0,0,0,0.6); transition: transform .18s ease; touch-action: pan-y; }
      .image-lightbox img.zoomed { transform: scale(2); cursor: grab; }
      .image-lightbox-close { position: absolute; top: 18px; right: 18px; background: transparent; border: none; color: #fff; font-size: 28px; line-height: 1; z-index: 2; }
      @media (max-width: 768px) {
        .image-lightbox img { max-width: 98vw; max-height: 80vh; }
        .image-lightbox-close { top: 12px; right: 12px; font-size: 24px; }
      }
    </style>
  </head>
  <body>
    <div class="scanline"></div>

    <div class="cyber-shell">
      <!-- 手机版侧边栏遮罩 -->
      <div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>
      <!-- Header -->
      <header class="cyber-header">
        <button class="sidebar-toggle" onclick="toggleSidebar()" aria-label="切换侧边栏" id="sidebarToggle">
          <svg viewBox="0 0 24 24" id="sidebarIcon" style="width: 24px; height: 24px; fill: var(--color-text);">
            <rect x="3" y="5" width="18" height="2" rx="1"/>
            <rect x="3" y="11" width="18" height="2" rx="1"/>
            <rect x="3" y="17" width="18" height="2" rx="1"/>
          </svg>
        </button>
        <!-- 主题切换按钮 -->
        <button class="theme-toggle" onclick="toggleTheme()" aria-label="切换主题" id="themeToggle">
          <svg viewBox="0 0 24 24" id="themeIcon">
            <path d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.389 5.389 0 0 1-4.4 2.26 5.403 5.403 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1z"/>
          </svg>
        </button>
        <a href="/" class="brand" style="text-decoration: none;">{manualTitle}</a>
        {showSidebar ? (
          <div style="font-size: 12px; opacity: 0.7;"></div>
        ) : (
          <a href="/" class="menu-btn" style="width: auto; padding: 8px 20px; text-decoration: none;">&larr; 首页</a>
        )}
      </header>

      {showSidebar ? (
        <!-- 侧边栏 -->
        <aside class="cyber-sidebar" id="sidebar">
          <!-- 系统状态模块 -->
          <SystemStatus />

          <nav>
            <div class="section-title">快速访问</div>
            {navLinks.map(link => (
              <a 
                href={link.url} 
                class:list={["menu-btn", { active: activePage === link.id }]}
                style="text-decoration: none; display: block;"
              >
                {link.name}
              </a>
            ))}
          </nav>

          <div style="margin-top: auto;">
            <a href="/logs" class="menu-btn" style="text-decoration: none; display: block; text-align: left;">
              [ 系统日志 ]
            </a>
          </div>
        </aside>
      ) : (
        <!-- 子页面侧边栏 -->
        <aside class="cyber-sidebar" id="sidebar">
          <SystemStatus />
          <div class="section-title">快速导航</div>
          {navLinks.map(link => (
            <a 
              href={link.url} 
              class:list={["menu-btn", { active: activePage === link.id }]}
              style="text-decoration: none;"
            >
              {link.name}
            </a>
          ))}
          <a href="/" class="menu-btn" style="border-color: var(--color-neon-pink); color: var(--color-neon-pink); text-decoration: none;">
            [ 返回手册 ]
          </a>
        </aside>
      )}

      <!-- 主内容区 -->
      <main class="cyber-main">
        <slot />
      </main>
    </div>

    <!-- Image Lightbox -->
    <div id="imageLightbox" class="image-lightbox" aria-hidden="true" role="dialog" tabindex="-1">
      <div class="image-lightbox-overlay" id="imageLightboxOverlay"></div>
      <button id="imageLightboxClose" class="image-lightbox-close" aria-label="关闭">✕</button>
      <img id="imageLightboxImg" src="" alt="" />
    </div>

  </body>
</html>

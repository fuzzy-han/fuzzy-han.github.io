---
import Layout from '../layouts/Layout.astro';
import MarkdownRenderer from '../components/MarkdownRenderer.astro';
import scheduleContent from '../content/schedule.md?raw';
---

<Layout title="日程安排" showSidebar={false} activePage="schedule">
  <div class="content-container">
    <section class="content-section">
      <MarkdownRenderer content={scheduleContent} />
    </section>
  </div>
</Layout>

<style>
  .content-container {
    max-width: 900px;
    margin: 0 auto;
  }
</style>

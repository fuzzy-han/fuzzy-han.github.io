---
import Layout from '../layouts/Layout.astro';
import MarkdownRenderer from '../components/MarkdownRenderer.astro';
import logsContent from '../content/logs.md?raw';
---

<Layout title="系统日志" showSidebar={false} activePage="logs">
  <div class="content-container">
    <div class="glitch-text" data-text="CHANGELOG" style="font-size: 48px; text-align: center; margin-bottom: 40px;">更新日志</div>
    <section class="content-section">
      <MarkdownRenderer content={logsContent} />
    </section>
  </div>
</Layout>

<style>
  .content-container {
    max-width: 900px;
    margin: 0 auto;
  }
</style>

---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SYSTEM_LOGS</title>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
  </head>
  <body>
    <div class="scanline"></div>
    
    <div class="cyber-shell" style="display: block; padding: 40px; overflow-y: auto;">
      <header class="cyber-header" style="margin-bottom: 40px;">
        <div class="brand">SYSTEM_LOGS // V.2025</div>
        <a href="/" class="menu-btn" style="width: auto; display: inline-block;">&lt; RETURN_TO_MAIN</a>
      </header>

      <div style="max-width: 800px; margin: 0 auto; font-family: var(--font-mono);">
        <div class="glitch-text" data-text="CHANGELOG" style="font-size: 48px;">CHANGELOG</div>
        
        <div style="margin-top: 40px; border-left: 2px solid var(--color-neon-pink); padding-left: 20px;">
          <h2 style="color: var(--color-neon-pink); margin-bottom: 10px;">[ BUILD_2025.0.1 ]</h2>
          <p style="color: var(--color-neon-cyan); margin-bottom: 20px;">
            > REFACTORED_UI_CORE<br>
            > IMPLEMENTED_NEURAL_PDF_LINKING<br>
            > REMOVED_AI_RESIDUE_PATTERNS<br>
            > OPTIMIZED_FOR_HIGH_SPEED_NAVIGATION
          </p>
        </div>

        <div style="margin-top: 40px; border-left: 2px solid var(--color-neon-acid); padding-left: 20px;">
          <h2 style="color: var(--color-neon-acid); margin-bottom: 10px;">[ SYSTEM_CREDITS ]</h2>
          <p style="color: white;">
            ARCHITECT: HAN<br>
            STYLE: CYBER_BRUTALISM<br>
            STATUS: OPERATIONAL
          </p>
        </div>

        <div style="margin-top: 60px; font-size: 12px; opacity: 0.5;">
          END_OF_FILE
        </div>
      </div>
    </div>
  </body>
</html>

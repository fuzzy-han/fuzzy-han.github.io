---
import Layout from '../layouts/Layout.astro';
import MarkdownRenderer from '../components/MarkdownRenderer.astro';
import faqContent from '../content/faq.md?raw';
---

<Layout title="常见问题" showSidebar={false} activePage="faq">
  <div class="content-container">
    <section class="content-section">
      <MarkdownRenderer content={faqContent} />
    </section>
  </div>
</Layout>

<style>
  .content-container {
    max-width: 900px;
    margin: 0 auto;
  }
</style>

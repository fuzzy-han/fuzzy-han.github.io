---
import Layout from '../layouts/Layout.astro';
import MarkdownRenderer from '../components/MarkdownRenderer.astro';
import introContent from '../content/intro.md?raw';
---

<Layout title="系统介绍" showSidebar={false} activePage="intro">
  <div class="content-container">
    <section class="content-section">
      <MarkdownRenderer content={introContent} />
    </section>
  </div>
</Layout>

<style>
  .content-container {
    max-width: 900px;
    margin: 0 auto;
  }
</style>

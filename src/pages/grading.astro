---
import Layout from '../layouts/Layout.astro';
import MarkdownRenderer from '../components/MarkdownRenderer.astro';
import gradingContent from '../content/grading.md?raw';
---

<Layout title="评分标准" showSidebar={false} activePage="grading">
  <div class="content-container">
    <section class="content-section">
      <MarkdownRenderer content={gradingContent} />
    </section>
  </div>
</Layout>

<style>
  .content-container {
    max-width: 900px;
    margin: 0 auto;
  }
</style>

---
import '../styles/global.css';

const pageTitle = "评分标准";
const manualTitle = "AUTO_OJ // 操作手册";

// 评分标准数据
const gradingCriteria = [
  {
    category: "代码正确性",
    weight: 50,
    description: "程序输出结果与预期完全一致",
    details: [
      "所有测试用例通过：50分",
      "部分测试用例通过：按比例给分",
      "无输出或输出错误：0分"
    ]
  },
  {
    category: "代码效率",
    weight: 20,
    description: "算法时间复杂度和空间复杂度符合要求",
    details: [
      "最优算法：20分",
      "可接受的算法：10-15分",
      "效率低下：5-10分"
    ]
  },
  {
    category: "代码规范",
    weight: 15,
    description: "代码风格、命名规范、注释",
    details: [
      "命名清晰、格式规范、注释完整：15分",
      "基本符合规范：10-12分",
      "规范性较差：5-9分"
    ]
  },
  {
    category: "边界处理",
    weight: 15,
    description: "对特殊情况和边界条件的处理",
    details: [
      "完整处理所有边界情况：15分",
      "处理主要边界情况：10-12分",
      "边界处理不足：5-9分"
    ]
  }
];

// 等级说明
const gradeLevels = [
  { range: "90-100", level: "优秀", color: "#39FF14", description: "完全掌握，代码质量高" },
  { range: "80-89", level: "良好", color: "#00F0FF", description: "基本掌握，有小问题" },
  { range: "70-79", level: "中等", color: "#FFFF00", description: "掌握主要知识，需改进" },
  { range: "60-69", level: "及格", color: "#FFA500", description: "基本要求达到，需加强" },
  { range: "0-59", level: "不及格", color: "#FF0000", description: "未达到要求，需重新学习" }
];
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle} - {manualTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
    <style>
      .grading-card {
        background: rgba(10, 10, 10, 0.9);
        border: 1px solid var(--color-neon-cyan);
        border-radius: 4px;
        padding: 20px;
        margin-bottom: 20px;
      }
      .weight-badge {
        display: inline-block;
        background: var(--color-neon-acid);
        color: #000;
        padding: 4px 12px;
        border-radius: 4px;
        font-weight: bold;
        margin-bottom: 10px;
      }
      .grade-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
      }
      .grade-table th, .grade-table td {
        border: 1px solid var(--color-neon-cyan);
        padding: 12px;
        text-align: left;
      }
      .grade-table th {
        background: rgba(0, 255, 255, 0.1);
        color: var(--color-neon-cyan);
      }
      .grade-indicator {
        display: inline-block;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        margin-right: 8px;
      }
      @media (max-width: 768px) {
        .grade-table {
          font-size: 12px;
        }
        .grade-table th, .grade-table td {
          padding: 8px;
        }
      }
    </style>
  </head>
  <body>
    <div class="cyber-shell">
      <!-- Header -->
      <header class="cyber-header">
        <div class="brand">{manualTitle}</div>
        <a href="/" class="menu-btn" style="width: auto; padding: 8px 20px; text-decoration: none;">&larr; 返回首页</a>
      </header>

      <!-- Sidebar -->
      <aside class="cyber-sidebar">
        <div class="section-title">快速导航</div>
        <a href="/intro" class="menu-btn">系统介绍</a>
        <a href="/schedule" class="menu-btn">日程安排</a>
        <a href="/grading" class="menu-btn active">评分标准</a>
        <a href="/faq" class="menu-btn">常见问题</a>
        <a href="/" class="menu-btn" style="border-color: var(--color-neon-pink); color: var(--color-neon-pink);">[ 返回手册 ]</a>
      </aside>

      <!-- Main Content -->
      <main class="cyber-main" style="overflow-y: auto; padding: 40px;">
        <div class="content-container">
          <section class="content-section">
            <h2>评分标准说明</h2>
            <p>每道题目总分为 100 分，从以下四个维度进行评分。请在提交代码前仔细检查，确保获得最高分。</p>
          </section>

          <section class="content-section">
            <h2>评分维度</h2>

            {gradingCriteria.map(criteria => (
              <div class="grading-card">
                <span class="weight-badge">{criteria.weight}%</span>
                <h3>{criteria.category}</h3>
                <p>{criteria.description}</p>
                <ul>
                  {criteria.details.map(detail => <li>{detail}</li>)}
                </ul>
              </div>
            ))}
          </section>

          <section class="content-section">
            <h2>等级说明</h2>
            <table class="grade-table">
              <thead>
                <tr>
                  <th>分数段</th>
                  <th>等级</th>
                  <th>说明</th>
                </tr>
              </thead>
              <tbody>
                {gradeLevels.map(grade => (
                  <tr>
                    <td>{grade.range}</td>
                    <td>
                      <span class="grade-indicator" style="background: {grade.color};"></span>
                      <strong>{grade.level}</strong>
                    </td>
                    <td>{grade.description}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </section>

          <section class="content-section">
            <h2>加分项</h2>
            <ul>
              <li>代码创新性：额外加 5-10 分</li>
              <li>超出要求完成：额外加 5 分</li>
              <li>代码复用性高：额外加 3-5 分</li>
            </ul>

            <h2>扣分项</h2>
            <ul>
              <li>代码抄袭：直接 0 分并记录</li>
              <li>提交恶意代码：直接 0 分并警告</li>
              <li>超过截止时间：每天扣除 10 分</li>
            </ul>
          </section>

          <section class="content-section">
            <h2>成绩查询</h2>
            <p>提交代码后可在系统日志页面查看实时评测结果和详细评分。每次提交都会记录，最终成绩取所有提交中的最高分。</p>
          </section>
        </div>
      </main>
    </div>
  </body>
</html>

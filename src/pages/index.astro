---
import Layout from '../layouts/Layout.astro';
import MarkdownRenderer from '../components/MarkdownRenderer.astro';

// 从 tutorial.md 读取完整教程
import fullTutorial from '../content/tutorial.md?raw';
---

<Layout title="首页" showSidebar={true} activePage="">
  <div class="content-container">
    <div class="welcome-section">
      <div class="glitch-text" data-text="AutoOj">AutoOj</div>
      <div style="font-size: 24px; margin-bottom: 40px; letter-spacing: 5px; text-align: center;">使用教程</div>
    </div>
    
    <section class="content-section">
      <MarkdownRenderer content={fullTutorial} />
    </section>
  </div>
</Layout>

<style>
  .welcome-section {
    text-align: center;
    margin-bottom: 40px;
  }
  
  .content-container {
    max-width: 900px;
    margin: 0 auto;
  }
</style>

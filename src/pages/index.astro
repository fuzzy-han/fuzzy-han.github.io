---
import '../styles/global.css';

const manualTitle = "AUTO_OJ // MANUAL";
const manualSubtitle = "V.2025.0.1 // EXPERIMENTAL";

// Data Structure Optimized for Navigation
const chapters = [
  { id: 1, title: "01 // ENV_SETUP", page: "1-10", startPage: 1 },
  { id: 2, title: "02 // DATA_TYPES", page: "11-25", startPage: 11 },
  { id: 3, title: "03 // CONTROL_FLOW", page: "26-40", startPage: 26 },
  { id: 4, title: "04 // ARRAYS_STR", page: "41-55", startPage: 41 },
  { id: 5, title: "05 // FUNCTIONS", page: "56-70", startPage: 56 },
  { id: 6, title: "06 // POINTERS", page: "71-85", startPage: 71 },
  { id: 7, title: "07 // STRUCTS", page: "86-100", startPage: 86 },
  { id: 8, title: "08 // FILE_IO", page: "101-115", startPage: 101 },
];

const quickLinks = [
  { name: "SYS_INTRO", id: "intro", page: 1 },
  { name: "SCHEDULE", id: "schedule", page: 116 }, // Assuming appendix
  { name: "GRADING", id: "grading", page: 118 },
  { name: "FAQ_DB", id: "faq", page: 120 },
];
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{manualTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
  </head>
  <body>
    <div class="scanline"></div>
    
    <div class="cyber-shell">
      <!-- Header -->
      <header class="cyber-header">
        <div class="brand">{manualTitle}</div>
        <div style="font-size: 12px; opacity: 0.7;">{manualSubtitle}</div>
      </header>

      <!-- Sidebar -->
      <aside class="cyber-sidebar">
        <!-- System Status Block -->
        <div style="border: 1px solid var(--color-neon-acid); padding: 10px; margin-bottom: 20px;">
          <div style="font-size: 10px; margin-bottom: 5px;">SYSTEM_STATUS</div>
          <div style="height: 4px; background: #333; width: 100%;">
            <div style="height: 100%; width: 87%; background: var(--color-neon-acid);"></div>
          </div>
          <div style="display: flex; justify-content: space-between; font-size: 10px; margin-top: 5px;">
            <span>MEM: 64TB</span>
            <span>NET: ONLINE</span>
          </div>
        </div>

        <nav>
          <div class="section-title">QUICK_ACCESS</div>
          {quickLinks.map(link => (
            <button 
              class="menu-btn" 
              onclick={`jumpToPage(${link.page})`}
            >
              {link.name}
            </button>
          ))}
        </nav>

        <nav>
          <div class="section-title">MODULES // CHAPTERS</div>
          {chapters.map(chapter => (
            <button 
              class="menu-btn" 
              onclick={`jumpToPage(${chapter.startPage})`}
            >
              {chapter.title}
            </button>
          ))}
        </nav>
        
        <div style="margin-top: auto;">
          <a href="/logs" class="menu-btn" style="text-decoration: none; display: block; text-align: left;">
            [ SYSTEM_LOGS ]
          </a>
          <button class="menu-btn" onclick="toggleOverlay()" style="border-color: var(--color-neon-pink); color: var(--color-neon-pink);">
            [ RESET_VIEW ]
          </button>
        </div>
      </aside>

      <!-- Main Content -->
      <main class="cyber-main">
        <!-- PDF Layer (Always Active) -->
        <iframe
          src="/manual.pdf#page=1"
          class="pdf-frame"
          id="pdfIframe"
          title="Manual Content"
        ></iframe>

        <!-- Overlay Layer -->
        <div class="pdf-overlay" id="welcomeOverlay">
          <div class="glitch-text" data-text="AUTO_OJ">AUTO_OJ</div>
          <div style="font-size: 24px; margin-bottom: 40px; letter-spacing: 5px;">INSTRUCTION MANUAL</div>
          
          <button 
            class="menu-btn" 
            style="width: 200px; text-align: center; font-size: 18px;"
            onclick="dismissOverlay()"
          >
            INITIALIZE >>
          </button>
        </div>
      </main>
    </div>

    <script is:inline>
      // PDF Control Logic
      const pdfFrame = document.getElementById('pdfIframe');
      const overlay = document.getElementById('welcomeOverlay');
      let isOverlayVisible = true;

      // Function to handle page jumping - The Core Bug Fix
      window.jumpToPage = (pageNumber) => {
        console.log(`Command received: JUMP_TO_SECTOR ${pageNumber}`);
        
        // Hide overlay if visible
        if (isOverlayVisible) {
          dismissOverlay();
        }

        // Force reload iframe with new page hash
        // Note: Just changing src hash might not always trigger reload in some browsers/PDF viewers
        // so we force a clean reload for robustness
        const currentSrc = pdfFrame.src.split('#')[0];
        pdfFrame.src = `${currentSrc}#page=${pageNumber}`;
      };

      window.dismissOverlay = () => {
        overlay.classList.add('hidden');
        isOverlayVisible = false;
      };

      window.toggleOverlay = () => {
        overlay.classList.toggle('hidden');
        isOverlayVisible = !isOverlayVisible;
      };

      // Sound Effect Simulation (Visual only for now)
      document.querySelectorAll('button').forEach(btn => {
        btn.addEventListener('mouseenter', () => {
          // Could add hover sound here
          console.log('AUD: HOVER_BEEP');
        });
        btn.addEventListener('click', () => {
           console.log('AUD: CLICK_CONFIRM');
        });
      });
    </script>
  </body>
</html>

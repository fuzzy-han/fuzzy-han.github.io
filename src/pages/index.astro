---
import '../styles/global.css';

const manualTitle = "AUTO_OJ // 操作手册";
const manualSubtitle = "V.2025.0.1 // 实验版本";

// 导航数据结构
const chapters = [
  { id: 1, title: "01 // 环境配置", page: "1-10", startPage: 1 },
  { id: 2, title: "02 // 数据类型", page: "11-25", startPage: 11 },
  { id: 3, title: "03 // 控制流程", page: "26-40", startPage: 26 },
  { id: 4, title: "04 // 数组字符串", page: "41-55", startPage: 41 },
  { id: 5, title: "05 // 函数", page: "56-70", startPage: 56 },
  { id: 6, title: "06 // 指针", page: "71-85", startPage: 71 },
  { id: 7, title: "07 // 结构体", page: "86-100", startPage: 86 },
  { id: 8, title: "08 // 文件操作", page: "101-115", startPage: 101 },
];

const quickLinks = [
  { name: "系统介绍", id: "intro", page: 1 },
  { name: "日程安排", id: "schedule", page: 116 },
  { name: "评分标准", id: "grading", page: 118 },
  { name: "常见问题", id: "faq", page: 120 },
];
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{manualTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
  </head>
  <body>
    <div class="scanline"></div>
    
    <div class="cyber-shell">
      <!-- Header -->
      <header class="cyber-header">
        <div class="brand">{manualTitle}</div>
        <div style="font-size: 12px; opacity: 0.7;">{manualSubtitle}</div>
      </header>

      <!-- 侧边栏 -->
      <aside class="cyber-sidebar">
        <!-- 系统状态模块 -->
        <div style="border: 1px solid var(--color-neon-acid); padding: 10px; margin-bottom: 20px;">
          <div style="font-size: 10px; margin-bottom: 5px;">系统状态</div>
          <div style="height: 4px; background: #333; width: 100%;">
            <div style="height: 100%; width: 87%; background: var(--color-neon-acid);"></div>
          </div>
          <div style="display: flex; justify-content: space-between; font-size: 10px; margin-top: 5px;">
            <span>内存: 64TB</span>
            <span>网络: 在线</span>
          </div>
        </div>

        <nav>
          <div class="section-title">快速访问</div>
          {quickLinks.map(link => (
            <button 
              class="menu-btn" 
              onclick={`jumpToPage(${link.page})`}
            >
              {link.name}
            </button>
          ))}
        </nav>

        <nav>
          <div class="section-title">模块 // 章节</div>
          {chapters.map(chapter => (
            <button 
              class="menu-btn" 
              onclick={`jumpToPage(${chapter.startPage})`}
            >
              {chapter.title}
            </button>
          ))}
        </nav>
        
        <div style="margin-top: auto;">
          <a href="/logs" class="menu-btn" style="text-decoration: none; display: block; text-align: left;">
            [ 系统日志 ]
          </a>
          <button class="menu-btn" onclick="toggleOverlay()" style="border-color: var(--color-neon-pink); color: var(--color-neon-pink);">
            [ 重置视图 ]
          </button>
        </div>
      </aside>

      <!-- 主内容区 -->
      <main class="cyber-main">
        <!-- PDF 图层 (始终激活) -->
        <iframe
          src="/manual.pdf#page=1"
          class="pdf-frame"
          id="pdfIframe"
          title="Manual Content"
        ></iframe>

        <!-- 覆盖层 -->
        <div class="pdf-overlay" id="welcomeOverlay">
          <div class="glitch-text" data-text="AUTO_OJ">AUTO_OJ</div>
          <div style="font-size: 24px; margin-bottom: 40px; letter-spacing: 5px;">操作手册</div>

          <button
            class="menu-btn"
            style="width: 200px; text-align: center; font-size: 18px;"
            onclick="dismissOverlay()"
          >
            初始化 >>
          </button>
        </div>
      </main>
    </div>

    <script is:inline>
      // PDF 控制逻辑
      const pdfFrame = document.getElementById('pdfIframe');
      const overlay = document.getElementById('welcomeOverlay');
      let isOverlayVisible = true;

      // 处理页面跳转函数
      window.jumpToPage = (pageNumber) => {
        console.log(`收到命令: 跳转至第 ${pageNumber} 页`);
        
        // 如果覆盖层可见则隐藏
        if (isOverlayVisible) {
          dismissOverlay();
        }

        // 强制重新加载 iframe 并跳转到新页面
        const currentSrc = pdfFrame.src.split('#')[0];
        pdfFrame.src = `${currentSrc}#page=${pageNumber}`;
      };

      window.dismissOverlay = () => {
        overlay.classList.add('hidden');
        isOverlayVisible = false;
      };

      window.toggleOverlay = () => {
        overlay.classList.toggle('hidden');
        isOverlayVisible = !isOverlayVisible;
      };

      // 音效模拟（目前仅视觉效果）
      document.querySelectorAll('button').forEach(btn => {
        btn.addEventListener('mouseenter', () => {
          console.log('音频: 鼠标悬停提示音');
        });
        btn.addEventListener('click', () => {
           console.log('音频: 点击确认音');
        });
      });
    </script>
  </body>
</html>

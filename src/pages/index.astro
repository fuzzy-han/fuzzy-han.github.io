---
import '../styles/global.css';

const siteName = "Fuzzy Han";
const tagline = "Developer & Explorer";

const skills = [
  { name: "Python", level: 90 },
  { name: "JavaScript/TypeScript", level: 85 },
  { name: "C/C++", level: 75 },
  { name: "Go", level: 70 },
  { name: "Database", level: 80 },
];

const projects = [
  {
    name: "AutoOJ",
    desc: "自动化在线评测系统",
    link: "https://github.com/fuzzy-han/AutoOJ"
  },
  {
    name: "OpenManus",
    desc: "AI 智能助手框架",
    link: "https://github.com/fuzzy-han/OpenManus"
  },
  {
    name: "DeepSearch Agent",
    desc: "深度搜索智能代理",
    link: "https://github.com/fuzzy-han/DeepSearchAgent-Demo"
  }
];

const socials = [
  { name: "GitHub", icon: "", url: "https://github.com/fuzzy-han" },
  { name: "Email", icon: "", url: "mailto:your-email@example.com" }
];
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Fuzzy Han - 个人简介网站" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{siteName}</title>
  </head>
  <body>
    <div class="container">
      <!-- Hero Section -->
      <header class="hero">
        <div class="avatar">
          <span class="avatar-text">FH</span>
        </div>
        <h1 class="name">{siteName}</h1>
        <p class="tagline">{tagline}</p>
        <p class="bio">
          热爱编程与探索，专注于软件开发、算法研究和 AI 技术。<br />
          享受解决复杂问题，持续学习新技术。
        </p>
        <div class="social-links">
          {socials.map(social => (
            <a href={social.url} target="_blank" rel="noopener" class="social-link">
              {social.name}
            </a>
          ))}
        </div>
      </header>

      <!-- Skills Section -->
      <section class="section">
        <h2 class="section-title">技术栈</h2>
        <div class="skills-grid">
          {skills.map(skill => (
            <div class="skill-item">
              <span class="skill-name">{skill.name}</span>
              <div class="skill-bar">
                <div class="skill-fill" style={`width: ${skill.level}%`}></div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Projects Section -->
      <section class="section">
        <h2 class="section-title">项目</h2>
        <div class="projects-grid">
          {projects.map(project => (
            <a href={project.link} target="_blank" rel="noopener" class="project-card">
              <h3 class="project-name">{project.name}</h3>
              <p class="project-desc">{project.desc}</p>
              <span class="project-link">查看项目 →</span>
            </a>
          ))}
        </div>
      </section>

      <!-- About Section -->
      <section class="section">
        <h2 class="section-title">关于</h2>
        <div class="about">
          <p>
            我是一名充满热情的开发者，对编程和技术探索充满热爱。
            在日常工作和学习中，我喜欢尝试各种新技术，解决实际问题，
            并通过开源社区分享我的成果。
          </p>
          <p>
            技术领域涉及 Web 开发、算法设计、数据库系统和人工智能。
            相信代码的力量可以改变世界。
          </p>
        </div>
      </section>

      <!-- Footer -->
      <footer class="footer">
        <p>© 2025 {siteName}. Built with Astro</p>
      </footer>
    </div>
  </body>
</html>
